              "id": "44444444-4444-4444-8444-444444444404",
              "name": "summary",
              "type": "string",
              "value": "={{ (() => { \n  const chats = $items(\"Get Today's Chat Logs\").flatMap(i => Array.isArray(i.json) ? i.json : [i.json]); \n  const events = $items(\"Get Today's System Events\").flatMap(i => Array.isArray(i.json) ? i.json : [i.json]); \n  \n  const fallbackCount = chats.filter(c => c.was_fallback === true || c.was_fallback === 'true').length; \n  const successCount = chats.length - fallbackCount;\n\n  const counts = events.reduce((acc, e) => { \n    const key = e.event_type || 'system event'; \n    acc[key] = (acc[key] || 0) + 1; \n    return acc; \n  }, {}); \n\n  const eventDetails = Object.keys(counts).length \n    ? Object.entries(counts).map(([key, val]) => `${val} ${key}`).join(', ') \n    : 'no system issues';\n\n  return `📊 *Daily Restaurant Bot Report*\\n\\n✅ Questions Answered: ${successCount}\\n⚠️ Fallback Errors: ${fallbackCount}\\n⚙️ System Events: ${eventDetails}\\n\\n_Everything is running smoothly!_`; \n})() }}"
            }
          ]
        },
        "options": {}
      },
